rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Users — public profile fields are readable by all signed-in users (needed for leaderboard + feed).
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      // carePoints/level/streak fields are only ever written server-side
      // (Admin SDK, after AI or human deed validation) — the client cannot
      // self-award points or fake a streak.
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['carePoints', 'level', 'currentStreak', 'longestStreak', 'lastDeedDate']);
      allow delete: if false;
    }

    // Deeds — anyone signed in can read APPROVED deeds (public feed). Owners see their own regardless of status.
    match /deeds/{deedId} {
      allow read: if signedIn() && (
        resource.data.status == 'approved' ||
        resource.data.userId == request.auth.uid
      );
      // Deeds always start pending and unvalidated — approval/rejection is
      // only ever decided server-side (AI validation route or admin panel).
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.cvConfidence == null;
      // Owner may only edit their caption while pending; status/points/cvConfidence
      // are server-only. Anyone signed-in can bump commentCount for their comment.
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption'])) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
      );
      allow delete: if false;

      // Comments — nested under each deed.
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    // Official posts — City Hall announcements + AI deed-doer spotlights.
    // Never client-writable: authored only by the admin panel or the AI
    // validation route, both via the Admin SDK (which bypasses these rules).
    match /officialPosts/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Weekly challenges — admin-authored (same pattern as officialPosts).
    // Client reads the current week's doc to render a progress bar; the
    // completions subcollection is an internal award-once ledger the Admin
    // SDK checks server-side and clients never need to read.
    match /weeklyChallenges/{weekId} {
      allow read: if signedIn();
      allow write: if false;

      match /completions/{uid} {
        allow read, write: if false;
      }
    }

  }
}
