# --- Firebase Web SDK (client) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server only) ---
# Generate a service account key in Firebase console and paste the JSON as a single line
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- OpenRouter AI ---
OPENROUTER_API_KEY=
# Vision-capable model used to grade deed proof photos (must support image inputs).
# Optional — defaults to openai/gpt-4o-mini.
OPENROUTER_VISION_MODEL=
# Model used by the in-app AI chat assistant. Optional — tried first, ahead of
# a built-in fallback list of free models (route auto-falls-through on 429/402/404).
OPENROUTER_CHAT_MODEL=

# --- Gmail SMTP (nodemailer) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Admin Panel ---
ADMIN_EMAILS=
ADMIN_JWT_SECRET=

# --- Demo content ---
# Set to "false" before a real launch to remove every seed/fake citizen and
# post from the leaderboard and feed. Defaults to shown (true) otherwise.
NEXT_PUBLIC_SHOW_DEMO_CONTENT=
